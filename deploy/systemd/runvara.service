[Unit]
Description=Runvara local Claude model gateway
Documentation=https://github.com/tiammomo/Runvara
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/runvara/runvara.env
Environment=RUST_LOG=runvara=info,tower_http=info
Environment=RUNVARA_STATE_DIR=/var/lib/runvara
Environment=RUNVARA_CONTROL_STORE=/var/lib/runvara/control-plane.json
ExecStart=/usr/local/bin/runvara
WorkingDirectory=/var/lib/runvara
Restart=always
RestartSec=3

DynamicUser=true
StateDirectory=runvara
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
