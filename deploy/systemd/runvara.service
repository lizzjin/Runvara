[Unit]
Description=Runvara local Claude model gateway
Documentation=https://github.com/tiammomo/Runvara
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/runvara/runvara.env
Environment=RUST_LOG=runvara=info,tower_http=info
ExecStart=/usr/local/bin/runvara
Restart=always
RestartSec=3

DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
